# Local Supabase stack (npm run db:start; keys from npm run db:status).
# A hosted project (.env.prod) uses https://<project-ref>.supabase.co and its API keys instead.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key — server only>
# Local: no TLS. Hosted: the Session pooler URI, port 5432, no ?sslmode suffix.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted only: path to the Supabase SSL root certificate (Database Settings → SSL).
DATABASE_CA_CERT=
SITE_URL=http://localhost:3000
# Test fixtures (LOCAL STACK ONLY): they create a known-password admin there.
ALLOW_TEST_FIXTURES=1
TEST_SUPABASE_PROJECT_REF=local
TEST_USER_PASSWORD=<random, never reuse>
# Production pilot switches (set in Vercel). EMAIL_ENABLED=false hides invites until SMTP is set up;
# NEXT_PUBLIC_PILOT=1 shows the pilot banner.
EMAIL_ENABLED=true
NEXT_PUBLIC_PILOT=0
# The app's own emails (checklist assignment notices). Unset SMTP_HOST = none sent.
# Local: the stack's Mailpit (http://127.0.0.1:54324). Prod (Vercel): smtp.gmail.com, 465, the Gmail
# address, a Gmail app password, SMTP_FROM="Implant Course <address>" (docs/operations.md).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Companies: every company and the console live in this one database. The app routes each request by its host
# through public.companies (addresses, status). Locally `npm run db:migrate` also adds the local companies:
# localhost / a.localhost = academy, tenant2.localhost = company-b, paused.localhost = suspended (dev-companies).
# Scripts load .env.local unless ENV_FILE names another file, e.g. ENV_FILE=.env.prod (production).
# Never name it .env.production*: Next.js loads those automatically for builds, which would point a local build at production.

# Console only (production): lets Add company put the company address on the Vercel project.
# Unset = the console shows the manual Vercel steps instead.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Self-Auth (own sign-in; replaces Supabase Auth). Secrets: 32+ random characters each.
SELF_AUTH_SECRET=
# Database-token signing key: npx supabase gen signing-key --algorithm ES256, as ONE JSON object here. For the
# local stack, put the same key wrapped in a JSON array in supabase/signing_keys.json (git-ignored).
# Supabase imports the PRIVATE key as a standby key (Project Settings -> JWT Keys).
SELF_AUTH_PRIVATE_JWK=
SELF_AUTH_KID=
# Optional: a Session-pooler URL for Self-Auth when DATABASE_URL is a transaction pooler that ignores
# `options=-c search_path=self_auth`.
SELF_AUTH_DATABASE_URL=
# Production: the Supabase CA certificate as PEM text (one line with \n, or multi-line). Self-Auth then verifies its
# database connections against it, so SELF_AUTH_DATABASE_URL carries no sslmode.
# Unset locally (the local stack has no TLS).
# SELF_AUTH_DATABASE_CA_CERT=

# Console host (also used for console invite/reset links), e.g. console.imploid.net; locally console.localhost:3000
# CONSOLE_HOST=

# Maintenance (Self-Auth switch-over, docs/operations.md §E): MAINTENANCE=1 serves a "back soon" page (503) on
# every host except /brand/*. The owner passes with MAINTENANCE_BYPASS_TOKEN (32+ random characters) sent as the
# cookie icm_maintenance_bypass or the header x-maintenance-bypass. Shorter tokens are ignored.
# MAINTENANCE=
# MAINTENANCE_BYPASS_TOKEN=
# Migration B (0103) is held unless SELF_AUTH_B_HOLD=0 (Release reads the GitHub production variable).
# SELF_AUTH_B_HOLD=

# Google sign-in (company hosts only; the console never uses it). Set both or neither. The OAuth client's
# authorized redirect URI is https://<company host>/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
