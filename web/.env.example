# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key — server only>
# Session pooler URI, port 5432, no ?sslmode suffix
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Path to the Supabase SSL root certificate (Database Settings → SSL). Required except on the dev project (ALLOW_TEST_FIXTURES=1).
DATABASE_CA_CERT=
# Test fixtures (DEV PROJECT ONLY): they create a known-password admin there.
ALLOW_TEST_FIXTURES=0
TEST_SUPABASE_PROJECT_REF=<dev project ref>
TEST_USER_PASSWORD=<random, never reuse>
# Production pilot switches (set in Vercel). EMAIL_ENABLED=false hides invites until SMTP is set up;
# NEXT_PUBLIC_PILOT=1 shows the pilot banner.
EMAIL_ENABLED=true
NEXT_PUBLIC_PILOT=0
# Multi-tenant (see docs/operations.md "Control project"). Leave unset for a single company (today's setup).
# App server: the control project that lists the companies.
CONTROL_SUPABASE_URL=
CONTROL_SERVICE_ROLE_KEY=
# Owner scripts only (db:migrate -- --control, tenant:register, tenant:check), in .env.prod; never in Vercel.
CONTROL_DATABASE_URL=
CONTROL_DATABASE_CA_CERT=
# Local isolation tests only: tenants.local.json (git-ignored, refused in production).
# TENANTS_FILE=tenants.local.json
# Scripts load .env.local unless ENV_FILE names another file, e.g. ENV_FILE=.env.prod (production).
# Never name it .env.production*: Next.js loads those automatically for builds, which would point a local build at production.
