# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key — server only>
# Session pooler URI, port 5432, no ?sslmode suffix
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Path to the Supabase SSL root certificate (Database Settings → SSL). Required except on the dev project (ALLOW_TEST_FIXTURES=1).
DATABASE_CA_CERT=
SITE_URL=http://localhost:3000
# Test fixtures (DEV PROJECT ONLY): they create a known-password admin there.
ALLOW_TEST_FIXTURES=0
TEST_SUPABASE_PROJECT_REF=<dev project ref>
TEST_USER_PASSWORD=<random, never reuse>
